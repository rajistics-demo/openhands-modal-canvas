+import { useEffect, useRef } from "react";
+import { useQueryClient } from "@tanstack/react-query";
+import { useTranslation } from "react-i18next";
+import { getActiveBackend } from "#/api/backend-registry/active-store";
+import type { ResolvedActiveBackend } from "#/api/backend-registry/types";
+import { recoverCloudConversationRuntime } from "#/api/cloud/conversation-service.api";
+import type { AppConversation } from "#/api/conversation-service/agent-server-conversation-service.types";
+import {
+  useSessionActivityStore,
+  sessionActivityKey,
+} from "#/stores/session-activity-store";
+import { I18nKey } from "#/i18n/declaration";
+import { displayErrorToast } from "#/utils/custom-toast-handlers";
+import { invalidateConversationQueries } from "./conversation-mutation-utils";
+
+interface CloudConversationRecoveryOptions {
+  backendChanged: boolean;
+  active: ResolvedActiveBackend;
+  conversation: AppConversation | null | undefined;
+  conversationId: string;
+  isFetched: boolean;
+  isFetchedAfterMount: boolean;
+  refetch: () => Promise<{ data: AppConversation | null | undefined }>;
+}
+
+export function useCloudConversationRecovery({
+  backendChanged,
+  active,
+  conversation,
+  conversationId,
+  isFetched,
+  isFetchedAfterMount,
+  refetch,
+}: CloudConversationRecoveryOptions) {
+  const { t } = useTranslation("openhands");
+  const queryClient = useQueryClient();
+  const lastOpen = useRef<string | null>(null);
+  const activeScope = useRef<string | null>(null);
+  const { backend, orgId } = active;
+  const scope = sessionActivityKey(backend.id, orgId, conversationId);
+
+  useEffect(() => {
+    if (lastOpen.current !== scope) lastOpen.current = null;
+    activeScope.current = backendChanged ? null : scope;
+    return () => {
+      activeScope.current = null;
+    };
+  }, [backendChanged, scope]);
+
+  useEffect(() => {
+    if (
+      backendChanged ||
+      backend.kind !== "cloud" ||
+      !orgId ||
+      !isFetched ||
+      conversation?.id !== conversationId ||
+      lastOpen.current === scope
+    ) {
+      return;
+    }
+
+    // Reading a conversation again is user intent. Polling an open tab is not.
+    lastOpen.current = scope;
+    if (isFetchedAfterMount && conversation.recovery_available !== true) return;
+
+    const recoveryOrg = orgId;
+    const isCurrent = () => {
+      const current = getActiveBackend();
+      return (
+        activeScope.current === scope &&
+        current.backend.id === backend.id &&
+        current.orgId === orgId
+      );
+    };
+
+    async function recover() {
+      const latest = isFetchedAfterMount
+        ? conversation
+        : (await refetch().catch(() => null))?.data;
+      if (
+        !isCurrent() ||
+        latest?.recovery_available !== true ||
+        latest.sandbox_status !== "MISSING"
+      ) {
+        return;
+      }
+
+      useSessionActivityStore.getState().begin(scope, "resume");
+      try {
+        await recoverCloudConversationRuntime(conversationId, recoveryOrg);
+      } catch {
+        if (isCurrent()) {
+          useSessionActivityStore.getState().observe(scope, "ERROR");
+          displayErrorToast(t(I18nKey.CONVERSATION$FAILED_TO_START_FROM_TASK));
+        }
+        return;
+      }
+
+      if (isCurrent())
+        invalidateConversationQueries(queryClient, conversationId);
+    }
+
+    void recover();
+  }, [
+    backendChanged,
+    backend.id,
+    backend.kind,
+    orgId,
+    conversation,
+    conversationId,
+    isFetched,
+    isFetchedAfterMount,
+    queryClient,
+    refetch,
+    scope,
+    t,
+  ]);
+}
