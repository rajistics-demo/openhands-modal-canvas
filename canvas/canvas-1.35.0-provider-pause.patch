+/** Enable the Pause action for the selected cloud backend on the pilot origin. */
+export function isCanvasRecoveryPilotOrigin(
+  backendHost: string,
+  pageOrigin: string = globalThis.location?.origin,
+): boolean {
+  const configuredOrigin = import.meta.env.VITE_CANVAS_RECOVERY_PILOT_ORIGIN;
+  if (!configuredOrigin || !pageOrigin) return false;
+  try {
+    const origin = new URL(configuredOrigin).origin;
+    return pageOrigin === origin && new URL(backendHost).origin === origin;
+  } catch {
+    return false;
+  }
+}
