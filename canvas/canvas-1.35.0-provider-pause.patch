+// @vitest-environment-options {"url":"https://app.example.test/"}
+import { render, screen, waitFor } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { ResolvedActiveBackend } from "#/api/backend-registry/types";
+import type { AppConversation } from "#/api/conversation-service/agent-server-conversation-service.types";
+import { PilotRecoveredPreview } from "#/components/features/conversation/pilot-recovered-preview";
+
+const fixture = vi.hoisted(() => ({ url: "" }));
+vi.mock("@tanstack/react-query", () => ({
+  useQuery: () => ({
+    data: {
+      id: "sandboxabc",
+      exposed_urls: [{ name: "WORKER_1", url: fixture.url }],
+    },
+  }),
+}));
+
+const active = {
+  backend: { id: "pilot", kind: "cloud", host: window.location.origin },
+  orgId: "pilot-org",
+} as ResolvedActiveBackend;
+const conversation = {
+  sandbox_id: "sandboxabc",
+  sandbox_status: "RUNNING",
+  session_api_key: null,
+  tags: { canvasrecoverypilotpreview: "true" },
+} satisfies Pick<AppConversation, "sandbox_id" | "sandbox_status" | "tags" | "session_api_key">;
+
+describe("PilotRecoveredPreview", () => {
+  beforeEach(() => {
+    vi.stubEnv("VITE_CANVAS_RECOVERY_PILOT_ORIGIN", window.location.origin);
+  });
+
+  afterEach(() => {
+    vi.unstubAllEnvs();
+    vi.unstubAllGlobals();
+  });
+
+  it("embeds the E2B preview bound to this sandbox and worker port", () => {
+    fixture.url = "https://8011-sandboxabc.e2b.app/";
+    render(<PilotRecoveredPreview conversation={conversation} active={active} />);
+
+    expect(screen.getByTitle("Live workspace preview")).toHaveAttribute(
+      "src",
+      fixture.url,
+    );
+  });
+
+  it.each([
+    "https://8011-othersandbox.e2b.app/",
+    "https://8000-sandboxabc.e2b.app/",
+    "https://8011-sandboxabc.e2b.app.invalid/",
+    "https://8011-sandboxabc.e2b.app/?key=synthetic",
+    "https://8011-sandboxabc.e2b.app/unexpected",
+    "invalid URL",
+    "https://other.preview.app.example.test/",
+  ])("rejects %s", (url) => {
+    fixture.url = url;
+    render(<PilotRecoveredPreview conversation={conversation} active={active} />);
+
+    expect(screen.queryByTitle("Live workspace preview")).toBeNull();
+  });
+});
+
+
+describe("credentialed MARS preview", () => {
+  afterEach(() => vi.unstubAllGlobals());
+
+  it("exchanges the sandbox key only on the matching preview origin before mounting", async () => {
+    fixture.url = "https://sandboxabc.preview.app.example.test/";
+    const grant = vi.fn().mockResolvedValue(new Response(null, { status: 204 }));
+    vi.stubGlobal("fetch", grant);
+
+    render(
+      <PilotRecoveredPreview
+        conversation={{ ...conversation, session_api_key: "synthetic-key", tags: {} }}
+        active={active}
+      />,
+    );
+    expect(screen.queryByTitle("Live workspace preview")).toBeNull();
+    expect(await screen.findByTitle("Live workspace preview")).toHaveAttribute("src", fixture.url);
+    expect(grant).toHaveBeenCalledExactlyOnceWith(
+      new URL("/.well-known/openhands-preview-session", fixture.url),
+      expect.objectContaining({
+        method: "POST",
+        credentials: "include",
+        redirect: "error",
+        headers: { "X-Session-API-Key": "synthetic-key" },
+      }),
+    );
+  });
+
+  it("keeps the preview hidden when authorization is refused", async () => {
+    fixture.url = "https://sandboxabc.preview.app.example.test/";
+    const grant = vi.fn().mockResolvedValue(new Response(null, { status: 401 }));
+    vi.stubGlobal("fetch", grant);
+
+    render(
+      <PilotRecoveredPreview
+        conversation={{ ...conversation, session_api_key: "synthetic-key", tags: {} }}
+        active={active}
+      />,
+    );
+    await waitFor(() => expect(grant).toHaveBeenCalled());
+    expect(screen.queryByTitle("Live workspace preview")).toBeNull();
+  });
+});
