+export async function recoverCloudConversationRuntime(
+  conversationId: string,
+  orgId: string,
+): Promise<void> {
+  const { backend, orgId: activeOrg } = getActiveBackend();
+  if (backend.kind !== "cloud" || activeOrg !== orgId) {
+    throw new Error("The recovery organization is no longer selected.");
+  }
+  await callCloudProxy({
+    backend,
+    method: "POST",
+    path: `/api/v1/app-conversations/${conversationId}/runtime/recover`,
+    timeoutSeconds: 120,
+  });
+}
